<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_host"
    app:startDestination="@id/mediaLibraryFragment">
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.search.ui.fragments.SearchFragment"
        android:label="SearchFragment" >
        <action
            android:id="@+id/action_searchFragment_to_mediaPlayerFragment"
            app:destination="@id/mediaPlayerFragment" />
    </fragment>
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.example.playlistmaker.media_library.ui.fragments.MediaLibraryFragment"
        android:label="MediaLibraryFragment" >
        <action
            android:id="@+id/action_mediaLibraryFragment_to_mediaPlayerFragment"
            app:destination="@id/mediaPlayerFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_infoPlaylistFragment"
            app:destination="@id/infoPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistmaker.settings.ui.fragments.SettingsFragment"
        android:label="SettingsFragment" />
    <fragment
        android:id="@+id/mediaPlayerFragment"
        android:name="com.example.playlistmaker.player.ui.fragments.MediaPlayerFragment"
        android:label="MediaPlayerFragment" >
        <action
            android:id="@+id/action_mediaPlayerFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.example.playlistmaker.new_playlist.ui.fragments.NewPlaylistFragment"
        android:label="NewPlaylistFragment" />
    <fragment
        android:id="@+id/infoPlaylistFragment"
        android:name="com.example.playlistmaker.info_playlist.ui.fragment.InfoPlaylistFragment"
        android:label="InfoPlaylistFragment" >
        <action
            android:id="@+id/action_infoPlaylistFragment_to_mediaPlayerFragment"
            app:destination="@id/mediaPlayerFragment" />
    </fragment>
</navigation>